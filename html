<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Teste: As 5 Linguagens do Amor — Silvana Monteiro</title>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  :root {
    --cream: #FAF7F4;
    --blush: #E8C4C0;
    --rose: #C4796E;
    --deep: #6B3D3A;
    --charcoal: #2A2020;
    --muted: #9A8080;
    --white: #FFFFFF;
    --shadow: rgba(107,61,58,0.12);
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--cream);
    font-family: 'Jost', sans-serif;
    color: var(--charcoal);
    min-height: 100vh;
  }

  /* HEADER / CAPA */
  .hero {
    background: linear-gradient(135deg, #FAF7F4 0%, #F3EAE7 60%, #E8D5D1 100%);
    padding: 0;
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute;
    top: -60px; right: -60px;
    width: 320px; height: 320px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(196,121,110,0.15) 0%, transparent 70%);
  }
  .hero::after {
    content: '';
    position: absolute;
    bottom: -40px; left: 10%;
    width: 200px; height: 200px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(232,196,192,0.3) 0%, transparent 70%);
  }
  .hero-inner {
    max-width: 900px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 0;
    padding: 0 40px;
    min-height: 220px;
    position: relative;
    z-index: 2;
  }
  .hero-photo {
    flex-shrink: 0;
    width: 200px;
    display: flex;
    align-items: flex-end;
  }
  .hero-photo img {
    width: 100%;
    display: block;
    filter: drop-shadow(0 4px 24px rgba(107,61,58,0.15));
  }
  .hero-text {
    flex: 1;
    padding: 36px 0 36px 48px;
  }
  .hero-subtitle {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 14px;
    color: var(--rose);
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 10px;
  }
  .hero-title {
    font-family: 'Cormorant Garamond', serif;
    font-weight: 600;
    font-size: clamp(26px, 4vw, 38px);
    color: var(--charcoal);
    line-height: 1.15;
    letter-spacing: 1px;
  }
  .hero-title span {
    color: var(--rose);
  }
  .hero-brand {
    margin-top: 16px;
    display: flex;
    flex-direction: column;
  }
  .brand-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 18px;
    font-weight: 400;
    color: var(--deep);
    letter-spacing: 1px;
  }
  .brand-role {
    font-family: 'Cormorant Garamond', serif;
    font-style: italic;
    font-size: 15px;
    color: var(--rose);
  }
  .hero-divider {
    height: 3px;
    background: linear-gradient(90deg, var(--rose) 0%, var(--blush) 60%, transparent 100%);
    margin: 0;
  }

  /* INTRO */
  .intro-band {
    background: var(--white);
    border-bottom: 1px solid rgba(196,121,110,0.15);
  }
  .intro-inner {
    max-width: 700px;
    margin: 0 auto;
    padding: 36px 40px;
    text-align: center;
  }
  .intro-inner p {
    font-size: 15px;
    line-height: 1.8;
    color: var(--muted);
    font-weight: 300;
  }
  .scale-legend {
    display: flex;
    justify-content: center;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 20px;
  }
  .scale-item {
    background: var(--cream);
    border: 1px solid var(--blush);
    border-radius: 20px;
    padding: 5px 14px;
    font-size: 12px;
    color: var(--deep);
    font-weight: 400;
  }
  .scale-item strong {
    color: var(--rose);
    font-weight: 600;
  }

  /* FORM */
  .form-wrap {
    max-width: 700px;
    margin: 0 auto;
    padding: 48px 40px 80px;
  }

  /* NOME + EMAIL */
  .personal-fields {
    background: var(--white);
    border-radius: 16px;
    padding: 32px;
    margin-bottom: 32px;
    box-shadow: 0 4px 24px var(--shadow);
    border-top: 3px solid var(--rose);
  }
  .personal-fields h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 20px;
    color: var(--deep);
    margin-bottom: 20px;
    font-weight: 600;
  }
  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .field-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .field-group label {
    font-size: 12px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
  }
  .field-group input {
    border: 1.5px solid rgba(196,121,110,0.25);
    border-radius: 8px;
    padding: 11px 14px;
    font-family: 'Jost', sans-serif;
    font-size: 14px;
    color: var(--charcoal);
    background: var(--cream);
    outline: none;
    transition: border-color .2s;
  }
  .field-group input:focus {
    border-color: var(--rose);
    background: var(--white);
  }

  /* SECTION CARD */
  .section-card {
    background: var(--white);
    border-radius: 16px;
    margin-bottom: 24px;
    box-shadow: 0 4px 24px var(--shadow);
    overflow: hidden;
    transition: transform .2s;
  }
  .section-card:hover { transform: translateY(-2px); }

  .section-header {
    padding: 22px 28px;
    display: flex;
    align-items: center;
    gap: 16px;
    border-bottom: 1px solid rgba(196,121,110,0.1);
  }
  .section-icon {
    width: 44px; height: 44px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 20px;
    flex-shrink: 0;
  }
  .section-title {
    flex: 1;
  }
  .section-title h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 21px;
    font-weight: 600;
    color: var(--deep);
  }
  .section-title span {
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .section-score {
    font-family: 'Cormorant Garamond', serif;
    font-size: 28px;
    font-weight: 300;
    color: var(--rose);
    min-width: 60px;
    text-align: right;
  }
  .score-label {
    font-family: 'Jost', sans-serif;
    font-size: 10px;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--muted);
    display: block;
    text-align: right;
  }

  .section-body { padding: 8px 0; }

  /* QUESTION ROW */
  .question-row {
    display: flex;
    align-items: center;
    padding: 12px 28px;
    gap: 16px;
    border-bottom: 1px solid rgba(232,196,192,0.2);
    transition: background .15s;
  }
  .question-row:last-child { border-bottom: none; }
  .question-row:hover { background: rgba(250,247,244,0.7); }

  .q-text {
    flex: 1;
    font-size: 14px;
    line-height: 1.5;
    color: var(--charcoal);
    font-weight: 300;
  }
  .q-num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 11px;
    color: var(--blush);
    min-width: 18px;
    font-style: italic;
  }

  .rating-group {
    display: flex;
    gap: 4px;
    flex-shrink: 0;
  }
  .rating-group input[type="radio"] { display: none; }
  .rating-group label {
    width: 34px; height: 34px;
    border-radius: 50%;
    border: 1.5px solid rgba(196,121,110,0.3);
    display: flex; align-items: center; justify-content: center;
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
    cursor: pointer;
    transition: all .2s;
    user-select: none;
  }
  .rating-group label:hover {
    border-color: var(--rose);
    color: var(--rose);
    background: rgba(196,121,110,0.06);
  }
  .rating-group input[type="radio"]:checked + label {
    background: var(--rose);
    border-color: var(--rose);
    color: var(--white);
    box-shadow: 0 2px 10px rgba(196,121,110,0.4);
  }

  /* SECTION COLORS */
  .cat-1 .section-icon { background: #FFF0EE; }
  .cat-2 .section-icon { background: #EEF5FF; }
  .cat-3 .section-icon { background: #FFF8EE; }
  .cat-4 .section-icon { background: #EEFFF4; }
  .cat-5 .section-icon { background: #F4EEFF; }

  .cat-1 .section-header { border-top: 3px solid #C4796E; }
  .cat-2 .section-header { border-top: 3px solid #6E9AC4; }
  .cat-3 .section-header { border-top: 3px solid #C4A76E; }
  .cat-4 .section-header { border-top: 3px solid #6EC487; }
  .cat-5 .section-header { border-top: 3px solid #9A6EC4; }

  /* PROGRESS */
  .progress-bar-wrap {
    background: var(--white);
    border-radius: 12px;
    padding: 24px 28px;
    margin-bottom: 28px;
    box-shadow: 0 2px 12px var(--shadow);
  }
  .progress-info {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
  }
  .progress-info span {
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .progress-info strong {
    font-family: 'Cormorant Garamond', serif;
    font-size: 20px;
    color: var(--rose);
  }
  .progress-track {
    height: 6px;
    background: var(--cream);
    border-radius: 6px;
    overflow: hidden;
  }
  .progress-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--rose) 0%, var(--blush) 100%);
    border-radius: 6px;
    transition: width .4s ease;
    width: 0%;
  }

  /* SUBMIT */
  .submit-area {
    text-align: center;
    padding-top: 16px;
  }
  .btn-submit {
    background: linear-gradient(135deg, var(--rose) 0%, var(--deep) 100%);
    color: var(--white);
    border: none;
    border-radius: 50px;
    padding: 16px 56px;
    font-family: 'Jost', sans-serif;
    font-size: 15px;
    letter-spacing: 2px;
    text-transform: uppercase;
    cursor: pointer;
    transition: all .3s;
    box-shadow: 0 6px 28px rgba(196,121,110,0.35);
    font-weight: 500;
  }
  .btn-submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 36px rgba(196,121,110,0.45);
  }
  .btn-submit:disabled {
    opacity: .5;
    cursor: not-allowed;
    transform: none;
  }
  .submit-note {
    margin-top: 14px;
    font-size: 12px;
    color: var(--muted);
  }

  /* RESULT MODAL */
  .overlay {
    display: none;
    position: fixed; inset: 0;
    background: rgba(42,32,32,0.6);
    backdrop-filter: blur(6px);
    z-index: 100;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .overlay.active { display: flex; }
  .result-modal {
    background: var(--white);
    border-radius: 20px;
    max-width: 560px;
    width: 100%;
    overflow: hidden;
    box-shadow: 0 20px 80px rgba(42,32,32,0.3);
    animation: popIn .4s cubic-bezier(.34,1.56,.64,1);
  }
  @keyframes popIn {
    from { opacity:0; transform: scale(.85) translateY(20px); }
    to { opacity:1; transform: scale(1) translateY(0); }
  }
  .result-header {
    background: linear-gradient(135deg, var(--rose) 0%, var(--deep) 100%);
    padding: 32px;
    text-align: center;
  }
  .result-header h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 28px;
    color: var(--white);
    font-weight: 600;
    margin-bottom: 6px;
  }
  .result-header p {
    color: rgba(255,255,255,0.75);
    font-size: 13px;
    letter-spacing: 1px;
  }
  .result-body { padding: 28px 32px; }
  .result-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 22px;
    color: var(--deep);
    text-align: center;
    margin-bottom: 24px;
    font-style: italic;
  }
  .result-bars { display: flex; flex-direction: column; gap: 12px; margin-bottom: 24px; }
  .result-bar-item { }
  .result-bar-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 5px;
  }
  .result-bar-label span { font-size: 13px; color: var(--charcoal); font-weight: 400; }
  .result-bar-label strong { font-family: 'Cormorant Garamond', serif; font-size: 18px; color: var(--rose); }
  .result-bar-track {
    height: 8px; background: var(--cream); border-radius: 8px; overflow: hidden;
  }
  .result-bar-fill {
    height: 100%; border-radius: 8px;
    transition: width .8s ease;
  }
  .principal-lang {
    background: linear-gradient(135deg, rgba(196,121,110,0.08) 0%, rgba(232,196,192,0.15) 100%);
    border: 1.5px solid var(--blush);
    border-radius: 12px;
    padding: 16px 20px;
    margin-bottom: 12px;
    text-align: center;
  }
  .principal-lang .badge { font-size: 11px; letter-spacing: 2px; text-transform: uppercase; color: var(--rose); margin-bottom: 4px; }
  .principal-lang h3 { font-family: 'Cormorant Garamond', serif; font-size: 24px; color: var(--deep); font-weight: 600; }
  .sheet-note {
    background: #EEFFF4;
    border-radius: 10px;
    padding: 14px 18px;
    font-size: 13px;
    color: #2A6040;
    text-align: center;
    margin-bottom: 20px;
    border: 1px solid #A8DFC0;
  }
  .btn-close {
    width: 100%;
    background: var(--cream);
    border: 1.5px solid var(--blush);
    border-radius: 50px;
    padding: 13px;
    font-family: 'Jost', sans-serif;
    font-size: 13px;
    color: var(--deep);
    cursor: pointer;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    transition: all .2s;
  }
  .btn-close:hover { background: var(--blush); }

  /* LOADING STATE */
  .btn-submit.loading { pointer-events: none; }
  .btn-submit.loading::after {
    content: ' ●●●';
    animation: dots 1s infinite;
  }
  @keyframes dots {
    0%,100% { opacity:.3 }
    50% { opacity:1 }
  }

  /* RESPONSIVE */
  @media (max-width: 600px) {
    .hero-photo { width: 130px; }
    .hero-inner { padding: 0 20px; min-height: 160px; }
    .hero-text { padding: 24px 0 24px 24px; }
    .form-wrap { padding: 32px 16px 60px; }
    .field-row { grid-template-columns: 1fr; }
    .question-row { flex-wrap: wrap; gap: 10px; }
    .rating-group label { width: 30px; height: 30px; font-size: 11px; }
    .personal-fields, .section-header, .question-row { padding-left: 18px; padding-right: 18px; }
  }
</style>
</head>
<body>

<!-- HERO / CAPA -->
<div class="hero">
  <div class="hero-inner">
    <div class="hero-photo">
      <!-- Imagem da Silvana Monteiro -->
      <img src="data:image/png;base64," alt="Silvana Monteiro">
    </div>
    <div class="hero-text">
      <p class="hero-subtitle">Autoconhecimento</p>
      <h1 class="hero-title">Teste: As <span>5 Linguagens</span><br>do Amor</h1>
      <div class="hero-brand">
        <span class="brand-name">Silvana Monteiro</span>
        <span class="brand-role">Terapeuta</span>
      </div>
    </div>
  </div>
</div>
<div class="hero-divider"></div>

<!-- INSTRUÇÃO -->
<div class="intro-band">
  <div class="intro-inner">
    <p>Leia cada afirmação e marque de acordo com o quanto ela representa você. Responda individualmente e com sinceridade — não há resposta certa ou errada.</p>
    <div class="scale-legend">
      <span class="scale-item"><strong>1</strong> Nada importante</span>
      <span class="scale-item"><strong>2</strong> Pouco importante</span>
      <span class="scale-item"><strong>3</strong> Moderado</span>
      <span class="scale-item"><strong>4</strong> Importante</span>
      <span class="scale-item"><strong>5</strong> Muito importante</span>
    </div>
  </div>
</div>

<!-- FORMULÁRIO -->
<div class="form-wrap">

  <!-- PROGRESSO -->
  <div class="progress-bar-wrap">
    <div class="progress-info">
      <span>Progresso</span>
      <strong id="progress-pct">0%</strong>
    </div>
    <div class="progress-track"><div class="progress-fill" id="progress-fill"></div></div>
  </div>

  <form id="love-form" onsubmit="return false;">

    <!-- DADOS PESSOAIS -->
    <div class="personal-fields">
      <h3>Suas informações</h3>
      <div class="field-row">
        <div class="field-group">
          <label>Nome completo *</label>
          <input type="text" id="nome" placeholder="Seu nome" required>
        </div>
        <div class="field-group">
          <label>E-mail *</label>
          <input type="email" id="email" placeholder="seu@email.com" required>
        </div>
        <div class="field-group">
          <label>WhatsApp</label>
          <input type="tel" id="whatsapp" placeholder="(xx) xxxxx-xxxx">
        </div>
        <div class="field-group">
          <label>Data de hoje</label>
          <input type="date" id="data">
        </div>
      </div>
    </div>

    <!-- 1. PALAVRAS DE AFIRMAÇÃO -->
    <div class="section-card cat-1">
      <div class="section-header">
        <div class="section-icon">💬</div>
        <div class="section-title">
          <span>Categoria 1</span>
          <h2>Palavras de Afirmação</h2>
        </div>
        <div>
          <div class="section-score" id="score-1">—</div>
          <span class="score-label">pontos</span>
        </div>
      </div>
      <div class="section-body" id="sec-1"></div>
    </div>

    <!-- 2. TEMPO DE QUALIDADE -->
    <div class="section-card cat-2">
      <div class="section-header">
        <div class="section-icon">🕰️</div>
        <div class="section-title">
          <span>Categoria 2</span>
          <h2>Tempo de Qualidade</h2>
        </div>
        <div>
          <div class="section-score" id="score-2">—</div>
          <span class="score-label">pontos</span>
        </div>
      </div>
      <div class="section-body" id="sec-2"></div>
    </div>

    <!-- 3. RECEBER PRESENTES -->
    <div class="section-card cat-3">
      <div class="section-header">
        <div class="section-icon">🎁</div>
        <div class="section-title">
          <span>Categoria 3</span>
          <h2>Receber Presentes</h2>
        </div>
        <div>
          <div class="section-score" id="score-3">—</div>
          <span class="score-label">pontos</span>
        </div>
      </div>
      <div class="section-body" id="sec-3"></div>
    </div>

    <!-- 4. ATOS DE SERVIÇO -->
    <div class="section-card cat-4">
      <div class="section-header">
        <div class="section-icon">🤝</div>
        <div class="section-title">
          <span>Categoria 4</span>
          <h2>Atos de Serviço</h2>
        </div>
        <div>
          <div class="section-score" id="score-4">—</div>
          <span class="score-label">pontos</span>
        </div>
      </div>
      <div class="section-body" id="sec-4"></div>
    </div>

    <!-- 5. TOQUE FÍSICO -->
    <div class="section-card cat-5">
      <div class="section-header">
        <div class="section-icon">🫂</div>
        <div class="section-title">
          <span>Categoria 5</span>
          <h2>Toque Físico</h2>
        </div>
        <div>
          <div class="section-score" id="score-5">—</div>
          <span class="score-label">pontos</span>
        </div>
      </div>
      <div class="section-body" id="sec-5"></div>
    </div>

    <!-- ENVIO -->
    <div class="submit-area">
      <button class="btn-submit" id="btn-submit" type="button" onclick="submeter()">
        Enviar Meu Resultado
      </button>
      <p class="submit-note">Suas respostas serão registradas com segurança</p>
    </div>
  </form>
</div>

<!-- MODAL DE RESULTADO -->
<div class="overlay" id="overlay">
  <div class="result-modal">
    <div class="result-header">
      <h2>Seu Resultado</h2>
      <p>As 5 Linguagens do Amor</p>
    </div>
    <div class="result-body">
      <div class="result-name" id="res-nome"></div>

      <div class="principal-lang">
        <p class="badge">Sua linguagem principal</p>
        <h3 id="res-principal">—</h3>
      </div>

      <div class="result-bars" id="res-bars"></div>

      <div class="sheet-note" id="sheet-note">
        ✓ Suas respostas foram registradas com sucesso!
      </div>

      <button class="btn-close" onclick="fecharModal()">Fechar</button>
    </div>
  </div>
</div>

<script>
const QUESTOES = {
  1: [
    "Eu me sinto amado(a) quando recebo elogios",
    "Gosto de ouvir 'eu te amo' com frequência",
    "Palavras de incentivo me motivam",
    "Fico ferido(a) com críticas",
    "Gosto quando reconhecem meus esforços"
  ],
  2: [
    "Me sinto amado(a) quando temos tempo só nosso",
    "Gosto de conversar sem distrações",
    "Valorizo momentos juntos mais que presentes",
    "Me sinto mal quando não temos tempo juntos",
    "Amo quando meu parceiro(a) está presente"
  ],
  3: [
    "Me sinto amado(a) quando recebo presentes",
    "Gosto de surpresas, mesmo simples",
    "Datas especiais são importantes para mim",
    "Guardo lembranças com carinho",
    "O gesto de lembrar de mim me toca"
  ],
  4: [
    "Me sinto amado(a) quando me ajudam",
    "Pequenas atitudes fazem diferença",
    "Valorizo quando fazem algo por mim",
    "Fico frustrado(a) quando não tenho ajuda",
    "Cuidado prático demonstra amor"
  ],
  5: [
    "Abraços me fazem sentir amado(a)",
    "Gosto de proximidade física",
    "Carinho físico é essencial para mim",
    "Sinto falta de contato físico",
    "Toque me conecta emocionalmente"
  ]
};

const NOMES = {
  1: "Palavras de Afirmação",
  2: "Tempo de Qualidade",
  3: "Receber Presentes",
  4: "Atos de Serviço",
  5: "Toque Físico"
};

const CORES = {
  1: "#C4796E",
  2: "#6E9AC4",
  3: "#C4A76E",
  4: "#6EC487",
  5: "#9A6EC4"
};

let qIndex = 1;

// Renderiza questões
Object.keys(QUESTOES).forEach(cat => {
  const container = document.getElementById('sec-' + cat);
  QUESTOES[cat].forEach((texto, i) => {
    const num = qIndex;
    const div = document.createElement('div');
    div.className = 'question-row';
    div.innerHTML = `
      <span class="q-num">${num}.</span>
      <span class="q-text">${texto}</span>
      <div class="rating-group" id="rg-${num}">
        ${[1,2,3,4,5].map(v => `
          <input type="radio" name="q${num}" id="q${num}v${v}" value="${v}">
          <label for="q${num}v${v}">${v}</label>
        `).join('')}
      </div>
    `;
    container.appendChild(div);

    // listener
    for(let v=1; v<=5; v++){
      document.getElementById(`q${num}v${v}`)?.addEventListener('change', () => {
        calcularScore(parseInt(cat));
        atualizarProgresso();
      });
    }

    qIndex++;
  });
});

// Define data de hoje
document.getElementById('data').valueAsDate = new Date();

function getVal(num) {
  const selected = document.querySelector(`input[name="q${num}"]:checked`);
  return selected ? parseInt(selected.value) : 0;
}

function calcularScore(cat) {
  const start = (cat - 1) * 5 + 1;
  let total = 0;
  for(let i = start; i < start + 5; i++) total += getVal(i);
  document.getElementById('score-' + cat).textContent = total > 0 ? total : '—';
  return total;
}

function atualizarProgresso() {
  let respondidas = 0;
  for(let i = 1; i <= 25; i++){
    if(document.querySelector(`input[name="q${i}"]:checked`)) respondidas++;
  }
  const pct = Math.round((respondidas / 25) * 100);
  document.getElementById('progress-fill').style.width = pct + '%';
  document.getElementById('progress-pct').textContent = pct + '%';
}

function submeter() {
  const nome = document.getElementById('nome').value.trim();
  const email = document.getElementById('email').value.trim();

  if(!nome || !email) {
    alert('Por favor, preencha seu nome e e-mail.');
    return;
  }

  for(let i = 1; i <= 25; i++){
    if(!document.querySelector(`input[name="q${i}"]:checked`)){
      alert(`Por favor, responda todas as questões. A questão ${i} ainda não foi respondida.`);
      return;
    }
  }

  const scores = {};
  let maxScore = 0, principal = '', secundaria = '';
  const scoreList = [];

  for(let cat = 1; cat <= 5; cat++){
    const s = calcularScore(cat);
    scores[cat] = s;
    scoreList.push({ cat, score: s, nome: NOMES[cat] });
  }

  scoreList.sort((a,b) => b.score - a.score);
  principal = scoreList[0].nome;
  secundaria = scoreList[1].nome;

  // Exibe resultado
  document.getElementById('res-nome').textContent = nome;
  document.getElementById('res-principal').textContent = principal;

  const barsEl = document.getElementById('res-bars');
  barsEl.innerHTML = '';
  scoreList.forEach(item => {
    const pct = Math.round((item.score / 25) * 100);
    barsEl.innerHTML += `
      <div class="result-bar-item">
        <div class="result-bar-label">
          <span>${item.nome}</span>
          <strong>${item.score} pts</strong>
        </div>
        <div class="result-bar-track">
          <div class="result-bar-fill" style="width:0%; background:${CORES[item.cat]}" data-w="${pct}%"></div>
        </div>
      </div>
    `;
  });

  document.getElementById('overlay').classList.add('active');

  setTimeout(() => {
    document.querySelectorAll('.result-bar-fill').forEach(el => {
      el.style.width = el.dataset.w;
    });
  }, 100);

  // Envia para Google Sheets
  enviarParaSheets(nome, email, scores, principal, secundaria);
}

function enviarParaSheets(nome, email, scores, principal, secundaria) {
  // =====================================================
  // CONFIGURAÇÃO DO GOOGLE SHEETS
  // Substitua pela URL do seu Google Apps Script Web App
  // Para configurar: Planilhas Google > Extensões > Apps Script
  // =====================================================
  const SHEET_URL = "https://script.google.com/macros/s/SEU_SCRIPT_ID_AQUI/exec";

  const whatsapp = document.getElementById('whatsapp').value.trim();
  const data = document.getElementById('data').value;

  // Respostas individuais
  const respostas = {};
  for(let i = 1; i <= 25; i++){
    const sel = document.querySelector(`input[name="q${i}"]:checked`);
    respostas['Q' + i] = sel ? sel.value : '';
  }

  const payload = {
    nome, email, whatsapp, data,
    palavras: scores[1],
    tempo: scores[2],
    presentes: scores[3],
    atos: scores[4],
    toque: scores[5],
    principal, secundaria,
    ...respostas
  };

  fetch(SHEET_URL, {
    method: 'POST',
    mode: 'no-cors',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(payload)
  }).then(() => {
    document.getElementById('sheet-note').textContent = '✓ Suas respostas foram registradas com sucesso!';
    document.getElementById('sheet-note').style.background = '#EEFFF4';
    document.getElementById('sheet-note').style.color = '#2A6040';
  }).catch(() => {
    document.getElementById('sheet-note').textContent = 'Resultado calculado! Configure a URL da planilha para registrar automaticamente.';
    document.getElementById('sheet-note').style.background = '#FFF8EE';
    document.getElementById('sheet-note').style.color = '#7A5020';
  });
}

function fecharModal() {
  document.getElementById('overlay').classList.remove('active');
}
</script>
